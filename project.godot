; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are loss-less and defaults will be used.

config_version=5

[application]

config/name="Abetia"
config/description="A 3D Souls-like game MVP"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.1", "GL Compatibility")
config/icon="res://icon.svg"

[input]

move_forward={
"deadzone": 0.5,
"events": [Key(keycode=87)]
}
move_backward={
"deadzone": 0.5,
"events": [Key(keycode=83)]
}
move_left={
"deadzone": 0.5,
"events": [Key(keycode=65)]
}
move_right={
"deadzone": 0.5,
"events": [Key(keycode=68)]
}
jump={
"deadzone": 0.5,
"events": [Key(keycode=32)]
}
attack={
"deadzone": 0.5,
"events": [Key(keycode=9)]
}
toggle_mouse={
"deadzone": 0.5,
"events": [Key(keycode=4194305)]
}

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
environment/defaults/default_ambient_light_enabled=true
environment/defaults/default_ambient_light_energy=1.0
